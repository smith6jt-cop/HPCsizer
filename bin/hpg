#!/usr/bin/env python3
"""hpg -- HPCsizer command line. All logic lives in lib/cli.py."""
# This file must stay valid for old interpreters so that the version check
# below can run and explain itself instead of failing with a syntax error.
import os
import sys

if sys.version_info < (3, 9):
    sys.stderr.write(
        "hpg needs Python 3.9 or newer; this is %d.%d (%s).\n"
        "Run it with a newer interpreter, e.g.  python3.11 %s ...\n"
        % (sys.version_info[0], sys.version_info[1], sys.executable, sys.argv[0])
    )
    sys.exit(2)

# Resolve symlinks so that `ln -s <repo>/bin/hpg ~/bin/hpg` finds the code.
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from lib.cli import main  # noqa: E402

sys.exit(main())
